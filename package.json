{
  "name": "live-tools",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Herramientas para TikTok LIVE: panel de configuración y widgets para OBS / TikTok LIVE Studio (React + Vite + TypeScript + Tailwind CSS).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "legado": "node pruebas/herramientas/servir.mjs legado 8080",
    "e2e": "node pruebas/e2e/todas.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
